rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function canRead() {
      return request.auth != null;
    }

    function canReadOwn() {
      return request.auth != null &&
             request.auth.uid == resource.data.userId;
    }

    function canCreateOwn() {
      return request.auth != null &&
             request.auth.uid == request.resource.data.userId;
    }

    function canUpdateOwn() {
      return request.auth != null &&
             request.auth.uid == resource.data.userId;
    }

    function canDeleteOwn() {
      return request.auth != null &&
             request.auth.uid == resource.data.userId;
    }

    match /jobApplications/{applicationId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }

    match /jobApplicationNotes/{noteId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }
    
    // A built resume (made in the app's editor) as the client writes it:
    // `text` is derived from `structured` on every save
    function isValidBuiltResume(data) {
      return data.kind == "built"
        && data.status == "parsed"
        && data.title is string && data.title.size() <= 120
        && data.template in ["classic", "compact"]
        && data.text is string && data.text.size() <= 60000
        && data.structured is map;
    }

    match /userResumes/{resumeId} {
      allow read: if canReadOwn();
      // Uploaded PDFs are created by parseResume (Admin SDK). Clients may
      // only create built resumes.
      allow create: if canCreateOwn()
        && request.resource.data.keys().hasOnly(["userId", "kind", "status", "title", "template", "text", "structured", "createdAt", "updatedAt"])
        && isValidBuiltResume(request.resource.data);
      allow update: if canUpdateOwn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get("kind", "upload") == resource.data.get("kind", "upload")
        && (resource.data.get("kind", "upload") != "built"
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["structured", "text", "title", "template", "updatedAt", "completedAt"])
            && isValidBuiltResume(request.resource.data)));
      allow delete: if canDeleteOwn();
    }
    
    match /contacts/{contactId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }
    
    match /interviews/{interviewId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }
    
    // A shared cache, not per-user data: the client only ever fetches one
    // job by the id the "jobs" callable (or a link/param already in hand)
    // handed back, and never lists the collection. Only Cloud Functions
    // (Admin SDK, which bypasses these rules) write to it, so client writes
    // are denied outright rather than scoped by userId, which these docs
    // don't carry and which a crafted create() could otherwise satisfy.
    match /jobs/{jobId} {
      allow get: if canRead();
      allow list, create, update, delete: if false;
    }
    
    match /coverLetters/{coverLetterId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }

    match /resumeJobMatches/{resumeJobMatchId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }

    // Tailored resumes are written only by createTailoredResume, whose
    // checks are what keep them honest. The owner may only switch edits
    // off and on (excludedOpIds), and delete the whole thing.
    match /tailoredResumes/{tailoredResumeId} {
      allow read: if canReadOwn();
      allow create: if false;
      allow update: if canUpdateOwn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["excludedOpIds", "updatedAt"])
        && request.resource.data.excludedOpIds is list
        && request.resource.data.excludedOpIds.size() <= 100;
      allow delete: if canDeleteOwn();
    }

    // "Report a wrong change" on a tailored version: create only, by the
    // owner of that version, with a fixed set of short fields. Read by
    // admins in the console, never by clients.
    match /tailoredResumeReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(["userId", "tailoredResumeId", "opIndex", "kind", "reason", "note", "before", "after", "requirement", "createdAt"])
        && request.resource.data.reason in ["not_true", "worse", "other"]
        && request.resource.data.kind in ["reworded", "moved", "cut", "skills"]
        && request.resource.data.opIndex is int
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.before is string && request.resource.data.before.size() <= 2000
        && request.resource.data.after is string && request.resource.data.after.size() <= 2000
        && request.resource.data.requirement is string && request.resource.data.requirement.size() <= 500
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/tailoredResumes/$(request.resource.data.tailoredResumeId)).data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Ghost-job signals: dated facts about a posting, keyed by the sha256 of
    // its job key. Anyone may read one by id (the extension has no auth);
    // nobody may list them or write them. The inputs they're computed from
    // (jobSignalsPrivate) fall through to the deny-all rule below.
    match /jobSignals/{keyHash} {
      allow get: if true;
      allow list, write: if false;
    }

    // Community reports: the reporter may read their own ({keyHash}_{uid},
    // so a get of one not made yet is allowed too). Written only by the
    // reportJob / withdrawJobReport callables. signalDisputes and the
    // dispute rate-limit counters fall through to the deny-all rule below.
    match /jobReports/{reportId} {
      allow get: if request.auth != null && reportId.matches('[0-9a-f]+_' + request.auth.uid);
      allow list, write: if false;
    }

    match /promptTemplates/{promptTemplateId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    function isOptionalShortString(data, key) {
      return !(key in data) || (data[key] is string && data[key].size() <= 200);
    }

    function isValidAcquisition(acquisition) {
      return acquisition is map &&
             acquisition.keys().hasOnly(['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'referrer_host', 'landing_path', 'captured_at']) &&
             acquisition.landing_path is string && acquisition.landing_path.size() <= 200 &&
             acquisition.captured_at is string && acquisition.captured_at.size() <= 40 &&
             isOptionalShortString(acquisition, 'utm_source') &&
             isOptionalShortString(acquisition, 'utm_medium') &&
             isOptionalShortString(acquisition, 'utm_campaign') &&
             isOptionalShortString(acquisition, 'utm_content') &&
             isOptionalShortString(acquisition, 'referrer_host');
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // The profile is written by Cloud Functions. Clients may only record their
      // first-touch acquisition source, once.
      allow read: if isOwner();
      allow create: if isOwner() &&
                       request.resource.data.keys().hasOnly(['acquisition']) &&
                       isValidAcquisition(request.resource.data.acquisition);
      allow update: if isOwner() &&
                       !('acquisition' in resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acquisition']) &&
                       isValidAcquisition(request.resource.data.acquisition);

      match /billingProfile/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
