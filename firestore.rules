rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function canRead() {
      return request.auth != null;
    }

    function canReadOwn() {
      return request.auth != null &&
             request.auth.uid == resource.data.userId;
    }

    function canCreateOwn() {
      return request.auth != null &&
             request.auth.uid == request.resource.data.userId;
    }

    function canUpdateOwn() {
      return request.auth != null &&
             request.auth.uid == resource.data.userId;
    }

    function canDeleteOwn() {
      return request.auth != null &&
             request.auth.uid == resource.data.userId;
    }

    match /jobApplications/{applicationId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }

    match /jobApplicationNotes/{noteId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }
    
    match /userResumes/{resumeId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }
    
    match /contacts/{contactId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }
    
    match /interviews/{interviewId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }
    
    match /jobs/{jobId} {
      allow read: if canRead();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }
    
    match /coverLetters/{coverLetterId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }

    match /resumeJobMatches/{resumeJobMatchId} {
      allow read: if canReadOwn();
      allow create: if canCreateOwn();
      allow update: if canUpdateOwn();
      allow delete: if canDeleteOwn();
    }

    // Ghost-job signals: dated facts about a posting, keyed by the sha256 of
    // its job key. Anyone may read one by id (the extension has no auth);
    // nobody may list them or write them. The inputs they're computed from
    // (jobSignalsPrivate) fall through to the deny-all rule below.
    match /jobSignals/{keyHash} {
      allow get: if true;
      allow list, write: if false;
    }

    // Community reports: the reporter may read their own ({keyHash}_{uid},
    // so a get of one not made yet is allowed too). Written only by the
    // reportJob / withdrawJobReport callables. signalDisputes and the
    // dispute rate-limit counters fall through to the deny-all rule below.
    match /jobReports/{reportId} {
      allow get: if request.auth != null && reportId.matches('[0-9a-f]+_' + request.auth.uid);
      allow list, write: if false;
    }

    match /promptTemplates/{promptTemplateId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    function isOptionalShortString(data, key) {
      return !(key in data) || (data[key] is string && data[key].size() <= 200);
    }

    function isValidAcquisition(acquisition) {
      return acquisition is map &&
             acquisition.keys().hasOnly(['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'referrer_host', 'landing_path', 'captured_at']) &&
             acquisition.landing_path is string && acquisition.landing_path.size() <= 200 &&
             acquisition.captured_at is string && acquisition.captured_at.size() <= 40 &&
             isOptionalShortString(acquisition, 'utm_source') &&
             isOptionalShortString(acquisition, 'utm_medium') &&
             isOptionalShortString(acquisition, 'utm_campaign') &&
             isOptionalShortString(acquisition, 'utm_content') &&
             isOptionalShortString(acquisition, 'referrer_host');
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // The profile is written by Cloud Functions. Clients may only record their
      // first-touch acquisition source, once.
      allow read: if isOwner();
      allow create: if isOwner() &&
                       request.resource.data.keys().hasOnly(['acquisition']) &&
                       isValidAcquisition(request.resource.data.acquisition);
      allow update: if isOwner() &&
                       !('acquisition' in resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acquisition']) &&
                       isValidAcquisition(request.resource.data.acquisition);

      match /billingProfile/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
