{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/blog/how-to-write-cover-letter-data-analyst", "destination": "/cover-letters/data-analyst", "permanent": true },
    { "source": "/blog/how-to-write-cover-letter-product-manager", "destination": "/cover-letters/product-manager", "permanent": true },
    { "source": "/blog/how-to-write-cover-letter-software-engineer", "destination": "/cover-letters/software-engineer", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/job-signals",
      "destination": "https://us-central1-applytrack-a4197.cloudfunctions.net/jobSignalsLookup"
    },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/:path*", "destination": "/app/index.html" },
    {
      "source": "/relay-VLVw/static/(.*)",
      "destination": "https://us-assets.i.posthog.com/static/$1"
    },
    {
      "source": "/relay-VLVw/(.*)",
      "destination": "https://us.i.posthog.com/$1"
    }
  ]
}
