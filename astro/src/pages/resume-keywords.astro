---
import Layout from '../layouts/Layout.astro'
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

type PostModule = {
  url?: string;
  frontmatter: {
    title: string;
    description?: string;
    pubDate?: string;
    role?: string;
    tags?: string[];
  };
}

const posts = Object.values(import.meta.glob<PostModule>('./resume-keywords/*.md', { eager: true }))
  .sort((a, b) => a.frontmatter.role.localeCompare(b.frontmatter.role));
const currentPath = Astro.url.pathname;

const pageTitle = "Resume Keywords by Job Title | OpenApply";
const pageDescription = "The must-have and nice-to-have keywords real employers list for each role, pulled from current job postings, plus how to prove each one on your resume.";
const canonicalUrl = new URL('/resume-keywords', Astro.site || 'https://openapply.app').href;

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Resume Keywords", url: "/resume-keywords" }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogType="website"
>
  <Header showHashLinks={false} currentPath={currentPath} />

  <main class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <Breadcrumbs items={breadcrumbItems} />

      <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-4">Resume Keywords by Role</h1>
      <p class="text-lg text-muted-foreground mb-4 max-w-3xl">
        We read through real, currently-listed job postings for each role below and pulled out the
        keywords that actually show up, split into must-haves (nearly every posting requires them)
        and nice-to-haves (some postings ask for them, others don't). Each page also says how to
        show that keyword on your resume with real evidence, not just by dropping the word in.
      </p>
      <p class="text-sm text-muted-foreground mb-12 max-w-3xl">
        Keyword lists go stale. Once you have an actual job posting, use the
        <a href="/tools/resume-job-match?utm_source=seo&utm_medium=internal_link&utm_campaign=sprint-2609&utm_content=resume-keywords-hub" class="text-primary underline hover:text-primary/80">free resume match checker</a>
        to compare your resume against that specific posting instead of a general list.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {posts.map((post) => (
          <article class="border border-border rounded-lg p-6 hover:border-primary transition-colors flex flex-col h-full">
            <a href={post.url} class="group flex flex-col h-full">
              <h2 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors mb-3">
                {post.frontmatter.title}
              </h2>
              {post.frontmatter.description && (
                <p class="text-muted-foreground mb-4 text-sm line-clamp-3 flex-grow">{post.frontmatter.description}</p>
              )}
              <div class="mt-auto">
                {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.frontmatter.tags.map((tag) => (
                      <span class="px-2 py-1 text-xs font-medium bg-secondary text-secondary-foreground rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <p class="text-muted-foreground text-center py-12">Resume keyword guides coming soon!</p>
      )}
    </div>
  </main>
  <Footer />
</Layout>
