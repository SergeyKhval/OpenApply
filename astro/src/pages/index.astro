---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JobLinkInput from '../components/vue/JobLinkInput.vue';
import { isDesktopChromium } from '../../../shared/browser';

const spaBase = import.meta.env.PUBLIC_SPA_BASE_URL || '/app';
const signupUrl = `${spaBase}/?mode=signup`;
const toolUrl = '/tools/resume-job-match?utm_source=landing&utm_medium=internal_link&utm_campaign=sprint-2609';

// Unset until the Chrome Web Store listing is live. Then desktop Chromium
// visitors get "Add to Chrome" first and everyone else keeps the link box.
const extensionUrl = import.meta.env.PUBLIC_EXTENSION_URL;
const hasExtension = Boolean(extensionUrl);

// Runs before the hero is parsed so the right variant shows on first paint
const detectBrowserScript = `if ((${isDesktopChromium.toString()})(navigator)) document.documentElement.classList.add("is-desktop-chromium");`;

const steps = [
  {
    icon: 'ph-link',
    title: 'Save a job',
    body: hasExtension
      ? 'One click on any job page with the extension. Or paste a link, or type the company and role.'
      : 'Paste a link from any job board and we fill in the details. Or type the company and role.',
  },
  {
    icon: 'ph-paper-plane-tilt',
    title: 'Apply and follow up',
    body: 'Mark it applied and we set a reminder to follow up a week later.',
  },
  {
    icon: 'ph-sparkle',
    title: 'Check your fit',
    body: 'See which must-haves your resume meets and what to fix, before you apply.',
  },
];

// Pricing and FAQ copy belong to the billing change (oa-7zn.1); it replaces
// these entries when Pro launches. Everything else on the page is layout.
const pricingPlans = [
  {
    name: 'Free',
    price: '$0',
    summary: 'Track your entire job search',
    features: [
      'Unlimited application tracking',
      'Paste-a-link job import',
      'Notes, due dates, and tags',
      'Resume and document storage',
      'Spreadsheet/CSV import',
    ],
    cta: 'Start free',
    featured: true,
  },
  {
    name: 'AI Features',
    price: 'From $0.12',
    summary: 'Pay-as-you-go. No subscription.',
    features: [
      'AI resume review from $0.12',
      'AI cover letter from $0.12',
      'Pay only when you use AI',
      'No subscriptions, no lock-in',
    ],
    cta: null,
    featured: false,
  },
];

const faqs = [
  {
    question: 'How do coins work?',
    answer: 'Coins are only spent on AI features like resume reviews and cover letters; tracking is free. Each review or cover letter costs 10 coins, and coin packs range from $0.012 to $0.02 per coin depending on pack size, so a review costs $0.12 to $0.20.',
  },
  {
    question: 'How do AI resume reviews work?',
    answer: 'Pick a job and a resume, and we check the match. You get a score with specific suggestions on what to improve, ready in under a minute.',
  },
  {
    question: 'Can I export my data?',
    answer: 'Yes. Download every job you track as a CSV from Settings, anytime. You can also import a spreadsheet to get started.',
  },
  {
    question: 'How does paste-a-link work?',
    answer: 'Paste a URL from any job board and we scrape the page to fill in the company, role, and description automatically. Works with most popular boards. If a site is tricky, you can always add details manually.',
  },
  {
    question: 'Can it write cover letters?',
    answer: "Yes. Pick a job and a resume, and the AI generates a cover letter tailored to both. You can regenerate until you're happy with it.",
  },
  {
    question: 'Can I self-host it?',
    answer: 'Yes. The code is on GitHub and you can run it with your own API keys.',
  },
  {
    question: 'Which currencies do you support?',
    answer: 'Billing is pay‑as‑you‑go; currency and pricing are shown at checkout.',
  },
];

const lanes = [
  { name: 'Saved', tone: 'bg-stage-saved-soft', jobs: [{ initials: 'FE', avatar: 'var(--avatar-3)', company: 'Fernway', role: 'Frontend Developer' }] },
  {
    name: 'Applied',
    tone: 'bg-stage-applied-soft',
    jobs: [
      { initials: 'BH', avatar: 'var(--avatar-4)', company: 'Brightline Health', role: 'Frontend Engineer' },
      { initials: 'TE', avatar: 'var(--avatar-7)', company: 'Tessel', role: 'UI Engineer' },
    ],
  },
  { name: 'Interviewing', tone: 'bg-stage-interviewing-soft', jobs: [{ initials: 'NL', avatar: 'var(--avatar-1)', company: 'Northwind Labs', role: 'Senior Frontend Engineer' }] },
];

const primaryButton = 'inline-flex h-[52px] items-center justify-center gap-2 whitespace-nowrap rounded-full border border-primary bg-primary px-[26px] text-[16.5px] font-semibold text-primary-foreground hover:bg-primary/90';
const cardSurface = 'rounded-card bg-card shadow-card border border-transparent dark:border-border';
---

<Layout
  title="OpenApply: a free job application tracker with follow-up reminders and resume checks"
  description="Keep every job application in one place. Paste a job link and the details are filled in, get a reminder to follow up, and check your resume against the job. Free."
>
  {hasExtension && <script is:inline set:html={detectBrowserScript} />}
  <div class="bg-background text-foreground antialiased">
    <Header currentPath="/" />
    <main id="main" class="mx-auto max-w-[1440px]">
      <!-- Hero -->
      <section class="flex flex-col gap-6 px-5 pt-4 pb-2 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-20 lg:pt-12 lg:pb-10">
        <div class="flex min-w-0 flex-col gap-5 lg:w-[620px] lg:shrink-0 lg:gap-7">
          <h1 class="m-0 font-display text-[44px] leading-none font-extrabold tracking-[-0.035em] lg:text-[76px]">
            Keep every job application in
            <span class="-ml-1 rounded-[12px] whitespace-nowrap bg-secondary px-2 [box-decoration-break:clone] lg:rounded-[16px] lg:px-3">one place.</span>
          </h1>
          <p class="m-0 max-w-[540px] text-[17px] leading-normal text-soft-foreground lg:text-xl">
            {hasExtension
              ? 'Save jobs from LinkedIn, Indeed or any career site in one click.'
              : 'Paste a job link from LinkedIn, Indeed or any career site and the details fill in.'}
            {' '}We remind you to follow up and check your resume against the job. Free.
          </p>

          {hasExtension && (
            <div class="hidden flex-col gap-2.5 chromium:flex">
              <a
                href={extensionUrl}
                target="_blank"
                rel="noopener"
                class:list={[primaryButton, 'self-start']}
                onclick="window.posthog?.capture('lp_extension_install_clicked', { from: 'hero' })"
              >
                <i class="ph ph-chrome-logo text-[19px]" aria-hidden="true"></i>
                Add to Chrome, it is free
              </a>
              <span class="text-sm text-muted-foreground">Works on LinkedIn, Greenhouse, Lever, Workday and most career sites.</span>
            </div>
          )}

          <div class="flex flex-col gap-2 lg:max-w-[560px]">
            {hasExtension && (
              <label for="hero-job-link" class="hidden text-[14.5px] text-soft-foreground chromium:block">
                No extension? Paste a job link instead.
              </label>
            )}
            <JobLinkInput
              client:visible
              inputId="hero-job-link"
              placeholder="https://www.linkedin.com/jobs/view/…"
              secondaryOnChromium={hasExtension}
            />
          </div>

          <div class="flex flex-col-reverse gap-5 lg:flex-row lg:items-center">
            <p class="m-0 flex items-center gap-2 text-[14.5px] text-muted-foreground">
              <i class="ph ph-shield-check text-[17px]" aria-hidden="true"></i>
              Free. Your data stays yours, export anytime.
            </p>
            <a
              href={signupUrl}
              class="self-start text-[15px] font-semibold text-secondary-foreground hover:text-foreground lg:text-[14.5px]"
              onclick="window.posthog?.capture('lp_signup_link_clicked', { from: 'hero' })"
            >
              or create a free account
            </a>
          </div>
        </div>

        <!-- Product visual: static markup, not a screenshot -->
        <div class="relative min-w-0 pt-2 lg:w-[620px] lg:shrink-0 lg:pt-0" aria-hidden="true">
          {hasExtension && (
            <div class="absolute top-0 right-0 z-10 hidden w-[304px] flex-col gap-3 rounded-[18px] border border-border bg-card p-4 shadow-pop lg:chromium:flex">
              <div class="flex items-center justify-between gap-3">
                <span class="flex items-center gap-[9px]">
                  <span class="grid size-6 place-items-center rounded-[8px_8px_8px_2px] bg-primary text-primary-foreground">
                    <i class="ph ph-check text-[13px]"></i>
                  </span>
                  <span class="font-display text-[17px] font-extrabold tracking-[-0.02em]">OpenApply</span>
                </span>
                <span class="text-[12.5px] text-muted-foreground">Extension</span>
              </div>
              <div class="flex flex-col gap-0.5 rounded-xl bg-muted p-3">
                <span class="text-[14.5px] font-bold">Senior Frontend Engineer</span>
                <span class="text-[13.5px] text-soft-foreground">Northwind Labs · Hybrid, Berlin</span>
                <span class="mt-1 flex items-center gap-1.5 text-[12.5px] font-semibold text-success">
                  <i class="ph ph-check text-sm"></i>Description read from the page
                </span>
              </div>
              <span class="inline-flex h-11 w-full items-center justify-center gap-2 rounded-full bg-primary text-[15px] font-semibold text-primary-foreground">
                <i class="ph ph-plus text-[17px]"></i>Save to OpenApply
              </span>
            </div>
          )}
          <div class="flex flex-col gap-3.5 rounded-[24px] bg-muted p-3.5 lg:w-[560px] lg:rounded-[28px] lg:p-5 lg:chromium:mt-[250px]">
            <div class="hidden items-center justify-between gap-3 lg:flex">
              <p class="m-0 font-display text-xl font-extrabold tracking-[-0.02em]">Good morning, Maya</p>
              <span class="inline-flex h-6 items-center rounded-full bg-secondary px-2.5 text-[12.5px] font-semibold whitespace-nowrap text-secondary-foreground">
                Follow up with Brightline today
              </span>
            </div>
            <div class="grid grid-cols-3 items-start gap-2.5">
              {lanes.map((lane) => (
                <div class:list={['flex min-w-0 flex-col gap-2 rounded-2xl p-2.5', lane.tone]}>
                  <span class="px-0.5 font-display text-[13.5px] font-bold">{lane.name}</span>
                  {lane.jobs.map((job) => (
                    <div class="flex items-center gap-2 rounded-xl bg-card p-2.5 shadow-card">
                      <span
                        class="hidden size-7 shrink-0 place-items-center rounded-full sm:grid font-display text-[10px] font-bold text-foreground"
                        style={`background: ${job.avatar}`}
                      >{job.initials}</span>
                      <span class="flex min-w-0 flex-col">
                        <span class="truncate text-[12.5px] font-bold">{job.company}</span>
                        <span class="truncate text-[11.5px] text-soft-foreground">{job.role}</span>
                      </span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section id="how-it-works" class="flex scroll-mt-20 flex-col gap-6 px-5 pt-12 lg:px-20 lg:pt-[72px]">
        <h2 class="m-0 font-display text-[30px] font-extrabold tracking-[-0.02em] lg:text-[40px]">How it works</h2>
        <div class="grid gap-3.5 lg:grid-cols-3 lg:gap-5">
          {steps.map((step, index) => (
            <section class:list={[cardSurface, 'flex flex-col gap-3 p-6']}>
              <div class="flex items-center gap-3">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-secondary text-secondary-foreground">
                  <i class:list={['ph', step.icon, 'text-[22px]']} aria-hidden="true"></i>
                </span>
                <span class="font-display text-[15px] font-bold text-muted-foreground">Step {index + 1}</span>
              </div>
              <h3 class="m-0 font-display text-[21px] font-bold tracking-[-0.02em]">{step.title}</h3>
              <p class="m-0 text-base leading-normal text-soft-foreground">{step.body}</p>
            </section>
          ))}
        </div>
      </section>

      <!-- Free check band -->
      <section class="mx-5 mt-10 flex flex-col gap-4 rounded-[28px] bg-secondary p-6 lg:mx-20 lg:mt-16 lg:flex-row lg:items-center lg:justify-between lg:gap-6 lg:px-10 lg:py-8">
        <div class="flex flex-col gap-1">
          <h2 class="m-0 font-display text-[22px] font-extrabold tracking-[-0.02em] lg:text-[26px]">Not ready to sign up?</h2>
          <p class="m-0 text-base text-soft-foreground">Check your resume against any job. No account needed.</p>
        </div>
        <a href={toolUrl} class:list={[primaryButton, 'w-full lg:w-auto']}>
          Try the free check
          <i class="ph ph-arrow-right text-base" aria-hidden="true"></i>
        </a>
      </section>

      <!-- Pricing -->
      <section id="pricing" class="flex scroll-mt-20 flex-col gap-6 px-5 pt-12 lg:px-20 lg:pt-[72px]">
        <h2 class="m-0 font-display text-[30px] font-extrabold tracking-[-0.02em] lg:text-[40px]">Pricing</h2>
        <div class="grid max-w-[900px] gap-5 lg:grid-cols-2">
          {pricingPlans.map((plan) => (
            <section
              class:list={[
                'flex flex-col gap-3.5 p-7',
                plan.featured ? cardSurface : 'rounded-card border-[1.5px] border-input',
              ]}
            >
              <h3 class="m-0 text-[15px] font-bold text-soft-foreground">{plan.name}</h3>
              <p class="m-0 font-display text-[44px] leading-tight font-extrabold tracking-[-0.02em]">{plan.price}</p>
              <p class="m-0 text-base text-soft-foreground">{plan.summary}</p>
              <ul class="m-0 flex list-none flex-col gap-2 p-0">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-base leading-normal text-soft-foreground">
                    <i class="ph ph-check mt-1 text-primary" aria-hidden="true"></i>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              {plan.cta && (
                <div class="mt-auto pt-2">
                  <a href={signupUrl} class:list={[primaryButton, 'w-full lg:w-auto']}>{plan.cta}</a>
                </div>
              )}
            </section>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="flex scroll-mt-20 flex-col gap-6 px-5 pt-12 lg:px-20 lg:pt-[72px]">
        <h2 class="m-0 font-display text-[30px] font-extrabold tracking-[-0.02em] lg:text-[40px]">Questions</h2>
        <div class="grid items-start gap-3.5 lg:grid-cols-2">
          {faqs.map((faq, index) => (
            <details class="group rounded-[18px] border border-transparent bg-card shadow-card dark:border-border" open={index === 0}>
              <summary class="flex min-h-[60px] cursor-pointer list-none items-center justify-between gap-4 px-[22px] py-3 text-[17px] font-semibold [&::-webkit-details-marker]:hidden">
                <h3 class="m-0 text-[17px] font-semibold">{faq.question}</h3>
                <i class="ph ph-caret-down shrink-0 text-lg transition-transform group-open:rotate-180" aria-hidden="true"></i>
              </summary>
              <p class="m-0 px-[22px] pb-5 text-base leading-[1.55] text-soft-foreground">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Closing -->
      <section class="mx-5 mt-12 flex flex-col gap-3.5 rounded-[28px] bg-muted px-[22px] py-7 lg:mx-20 lg:mt-[72px] lg:flex-row lg:items-center lg:justify-between lg:gap-6 lg:rounded-[32px] lg:px-12 lg:py-11">
        <h2 class="m-0 max-w-[520px] font-display text-[28px] font-extrabold tracking-[-0.02em] lg:text-4xl">Stop losing track of where you applied.</h2>
        <div class="lg:w-[520px]">
          <JobLinkInput client:visible inputId="closing-job-link" />
        </div>
      </section>
      <div class="h-12"></div>
    </main>
    <Footer />
  </div>
</Layout>
