---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LinkedinRewriteTool from '../../components/vue/LinkedinRewriteTool.vue';

const currentPath = Astro.url.pathname;
const pageTitle = "Free LinkedIn Headline & About Rewriter | OpenApply";
const pageDescription = "Paste your LinkedIn headline and About section. Get a sharper rewrite that only uses facts already in your text, checked line by line so it never invents a skill, employer, or title. Free, no signup.";
const canonicalUrl = new URL('/tools/linkedin-headline-rewrite', Astro.site || 'https://openapply.app').href;
const ogImage = 'https://openapply.app/images/og/linkedin-headline-rewrite.png';

const reusablePrompt = `You are a blunt LinkedIn profile editor. Rewrite my headline and About section so they read sharper and more confident, using only what I already wrote.

Hard rule: never invent anything. Do not add employers, tools, skills, numbers, years, credentials, or a stronger ownership word (helped -> led, supported -> managed) than what I wrote. Do not drop a hedge I used (a side project, started learning, a handful of, informally), since that would make a weak claim read strong. Do not claim a team's or someone else's work as my own.

If I give you a target role, reorder and emphasize my existing experience toward it. Do not claim the title itself, a skill, or a level of seniority I didn't already state, even if the role implies it.

Return: a rewritten headline (under 220 characters), a rewritten About section, and one sentence on the angle you took and why.

Target role (optional): PASTE THE ROLE HERE, OR DELETE THIS LINE

<headline>
PASTE YOUR CURRENT HEADLINE HERE
</headline>

<about>
PASTE YOUR CURRENT ABOUT SECTION HERE
</about>`;

const faqs = [
  {
    question: "Is it really free?",
    answer: "Yes. No signup, no credit card. There's a daily limit per person to keep it free for everyone.",
  },
  {
    question: "Do you store my headline or About section?",
    answer: "No. Your text is sent to Google Gemini for this one rewrite and is not saved.",
  },
  {
    question: "Will it make up experience I don't have?",
    answer: "No, on purpose. Every rewritten line is checked in code against everything you pasted. A line that adds a skill, employer, number, credential, or stronger ownership word than you stated gets thrown out and your original wording is kept instead, marked \"kept your wording\" so you can see exactly what changed.",
  },
  {
    question: "What if I give it a target role?",
    answer: "It reorders and emphasizes your existing experience toward that role. It still won't claim a title, skill, or seniority level you didn't already state, even if the role implies it.",
  },
  {
    question: "Can I use the prompt myself?",
    answer: "Please do. The full prompt is above. Paste it into ChatGPT, Claude, or Gemini with your headline and About section. Without the code check this tool runs, read the result carefully for anything it added.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "LinkedIn Headline & About Rewriter",
      "url": canonicalUrl,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription,
      "isPartOf": {
        "@type": "SoftwareApplication",
        "name": "OpenApply",
        "url": "https://openapply.app/",
        "applicationCategory": "BusinessApplication",
      },
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="linkedin headline generator, linkedin about section rewriter, linkedin profile optimizer free, rewrite linkedin summary, linkedin headline examples"
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  includeMonoFont
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="bg-background text-foreground antialiased">
    <Header currentPath={currentPath} />

    <main id="main">
      <section class="relative overflow-hidden">
        <div class="absolute inset-0 bg-background"></div>
        <div class="container mx-auto px-4 pt-12 pb-16 lg:pt-16 relative z-10 max-w-6xl">
          <div id="tool-hero-full" class="text-center max-w-3xl mx-auto mb-10">
            <p class="inline-flex items-center gap-2 rounded-full bg-secondary px-3.5 py-1.5 text-xs font-semibold text-secondary-foreground mb-5">
              Free tool · No signup
            </p>
            <h1 class="text-4xl lg:text-6xl font-extrabold leading-[1.05] tracking-tight mb-5">
              Rewrite your LinkedIn headline and About, honestly
            </h1>
            <p class="text-lg text-muted-foreground">
              Paste your headline and About section. In about 15 seconds you get a sharper
              version that only uses facts already in your text. Every line is checked in code,
              so it never invents a skill, employer, number, or title, and shows you exactly
              which lines it kept as-is.
            </p>
          </div>
          <p id="tool-hero-collapsed" class="hidden text-center text-lg font-semibold text-foreground mb-6">
            Your rewrite is ready
          </p>

          <LinkedinRewriteTool client:load />
        </div>
      </section>

      <section class="py-16 bg-muted/40">
        <div class="container mx-auto px-4 max-w-4xl">
          <h2 class="text-3xl font-bold mb-3">The prompt behind this tool</h2>
          <p class="text-muted-foreground mb-6">
            No secret sauce. This is what the tool asks the AI, rewritten so you can paste it
            into ChatGPT, Claude, or Gemini yourself.
          </p>
          <div class="relative rounded-card border border-border bg-card">
            <button
              type="button"
              id="copy-prompt"
              class="absolute right-3 top-3 inline-flex items-center gap-2 rounded-full border border-input bg-card px-3.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted"
            >
              <i class="ph ph-copy" aria-hidden="true"></i>
              <span>Copy prompt</span>
            </button>
            <pre id="reusable-prompt" class="max-h-96 overflow-auto whitespace-pre-wrap p-5 pt-14 font-mono text-xs sm:text-sm leading-relaxed text-foreground">{reusablePrompt}</pre>
          </div>
        </div>
      </section>

      <section class="py-16">
        <div class="container mx-auto px-4 max-w-4xl">
          <h2 class="text-3xl font-bold mb-8">Questions</h2>
          <div class="flex flex-col gap-6">
            {faqs.map((faq) => (
              <div>
                <h3 class="text-lg font-semibold mb-2">{faq.question}</h3>
                <p class="text-muted-foreground">{faq.answer}</p>
              </div>
            ))}
          </div>
          <p class="mt-10 text-muted-foreground">
            Applying to a specific job next? Try the
            {" "}<a href="/tools/resume-job-match" class="font-semibold text-primary hover:underline">free resume vs job description match checker</a>
            {" "}too.
          </p>
          <div class="mt-6 rounded-card bg-secondary p-8 text-center">
            <p class="text-muted-foreground mb-4">
              OpenApply is a free job application tracker. Paste a job link, track
              every application, and get AI resume reviews when you want them.
            </p>
            <a
              href="/app/?utm_source=tool&utm_medium=cta&utm_campaign=linkedin_rewrite"
              id="footer-cta"
              class="inline-flex items-center justify-center gap-2 text-[15px] font-semibold h-12 rounded-full px-6 bg-primary text-primary-foreground hover:bg-primary/90"
            >
              Start tracking for free
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<script>
  const posthog = () => (window as any).posthog;

  document.getElementById('copy-prompt')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const text = document.getElementById('reusable-prompt')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(text);
      const label = button.querySelector('span');
      if (label) {
        label.textContent = 'Copied';
        setTimeout(() => (label.textContent = 'Copy prompt'), 2000);
      }
    } catch {
      // Clipboard can be blocked; the prompt is still selectable
    }
    posthog()?.capture('tool_prompt_copied', { tool: 'linkedin_rewrite' });
  });

  const footerCta = document.getElementById('footer-cta') as HTMLAnchorElement | null;
  const incoming = new URLSearchParams(window.location.search);
  if (footerCta && incoming.has('utm_source')) {
    const url = new URL(footerCta.href);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((key) => {
      url.searchParams.delete(key);
      const value = incoming.get(key);
      if (value) url.searchParams.set(key, value);
    });
    footerCta.href = url.toString();
  }
  footerCta?.addEventListener('click', () => {
    posthog()?.capture('tool_cta_clicked', { tool: 'linkedin_rewrite', cta: 'footer_signup' });
  });

  window.addEventListener('oa:tool-result', () => {
    document.getElementById('tool-hero-full')?.classList.add('hidden');
    document.getElementById('tool-hero-collapsed')?.classList.remove('hidden');
  });

  window.addEventListener('oa:tool-reset', () => {
    document.getElementById('tool-hero-full')?.classList.remove('hidden');
    document.getElementById('tool-hero-collapsed')?.classList.add('hidden');
  });
</script>
