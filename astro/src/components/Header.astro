---
import Logo from './Logo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const isOnBlogPage = currentPath.startsWith('/blog');
const isOnResumeMatchPage = currentPath.startsWith('/tools/resume-job-match');

const navLinks = [
  { href: '/tools/resume-job-match', label: 'Free resume check', active: isOnResumeMatchPage },
  { href: '/#pricing', label: 'Pricing', active: false },
  { href: '/blog', label: 'Blog', active: isOnBlogPage },
];
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-primary-foreground"
>
  Skip to content
</a>
<header class="sticky top-0 z-50 bg-background/90 backdrop-blur-lg">
  <div class="relative mx-auto flex h-[68px] max-w-[1440px] items-center gap-3 px-5 lg:h-20 lg:px-20">
    <Logo />

    <!-- Mobile menu toggle (checkbox hack for a CSS-only menu) -->
    <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" aria-label="Toggle menu" />

    <nav
      aria-label="Main"
      class="invisible absolute inset-x-0 top-full flex -translate-y-2 flex-col gap-1 border-b border-border bg-background p-4 opacity-0 transition-all duration-200 peer-checked:visible peer-checked:translate-y-0 peer-checked:opacity-100 lg:visible lg:static lg:ml-10 lg:translate-y-0 lg:flex-row lg:gap-[30px] lg:border-0 lg:bg-transparent lg:p-0 lg:opacity-100"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? 'page' : undefined}
          class:list={[
            'rounded-full px-4 py-3 text-[15px] font-medium transition-colors hover:bg-muted hover:text-foreground lg:p-0 lg:hover:bg-transparent',
            link.active ? 'text-foreground font-semibold' : 'text-soft-foreground',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/app?mode=signup"
        class="mt-2 inline-flex h-11 items-center justify-center rounded-full bg-primary px-5 text-[15px] font-semibold text-primary-foreground lg:hidden"
        onclick="window.posthog?.capture('header_get_started_clicked', { source: 'header_menu' })"
      >
        Start free
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:gap-2">
      <a
        href="/app"
        class="inline-flex h-[34px] items-center rounded-full px-3.5 text-[13.5px] font-semibold text-soft-foreground hover:bg-muted hover:text-foreground lg:h-11 lg:px-5 lg:text-[15px]"
        onclick="window.posthog?.capture('header_sign_in_clicked', { source: 'header' })"
      >
        Sign in
      </a>
      <a
        href="/app?mode=signup"
        class="hidden h-11 items-center rounded-full border border-input bg-card px-5 text-[15px] font-semibold text-foreground hover:bg-muted lg:inline-flex"
        onclick="window.posthog?.capture('header_get_started_clicked', { source: 'header' })"
      >
        Start free
      </a>
      <label
        for="mobile-menu-toggle"
        class="grid size-11 cursor-pointer place-items-center rounded-full border border-input bg-card text-foreground lg:hidden"
        aria-label="Menu"
      >
        <i class="ph ph-list text-xl leading-none" aria-hidden="true"></i>
      </label>
    </div>
  </div>
</header>
