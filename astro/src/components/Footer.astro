---
import Logo from './Logo.astro';

const links = [
  { href: '/tools/resume-job-match', label: 'Free resume check' },
  { href: '/resume-keywords', label: 'Resume keywords' },
  { href: '/resumes', label: 'Resume guides' },
  { href: '/cover-letters', label: 'Cover letter examples' },
  { href: '/blog', label: 'Blog' },
  { href: 'https://github.com/SergeyKhval/OpenApply', label: 'GitHub', external: true },
  { href: 'mailto:support@openapply.app', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="mx-auto flex max-w-[1440px] flex-col gap-[18px] px-5 pt-8 pb-10 lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-20">
  <Logo size="sm" />
  <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-2 lg:justify-end lg:gap-x-7">
    {links.map((link) => (
      <a
        href={link.href}
        class="text-[14.5px] text-soft-foreground hover:text-foreground"
        {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {link.label}
      </a>
    ))}
  </nav>
</footer>
